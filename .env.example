# Database Configuration (PostgreSQL + TimescaleDB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/der_scada?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# SCADA Configuration
SCADA_WEBSOCKET_PORT=3001
MQTT_BROKER_URL="mqtt://localhost:1883"
MODBUS_TCP_PORT=502
OPC_UA_ENDPOINT="opc.tcp://localhost:4840"

# Historian Configuration
HISTORIAN_RETENTION_DAYS=365

# AI Engine Configuration
AI_ENGINE_ENABLED=true
AI_OPTIMIZATION_INTERVAL_MINUTES=5
